{
  "name": "imade",
  "version": "2.3.0",
  "description": "Personal song library with comparison ranking",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "build:client": "vite build",
    "start": "node server.js",
    "electron": "electron .",
    "build": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "build:all": "vite build && electron-builder -mwl"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.berrynotes.imade",
    "productName": "iMade",
    "asar": true,
    "win": {
      "target": "zip"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": ["AppImage", "zip"],
      "category": "Audio"
    },
    "artifactName": "iMade-${version}.${ext}",
    "files": [
      "electron.js",
      "server.js",
      "dist-client/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*"
    ]
  }
}
